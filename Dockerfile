# ── Frontend build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS ui
WORKDIR /src
COPY web/package.json web/package-lock.json* ./
RUN npm install
COPY web/ ./
RUN npm run build

# ── Backend build ───────────────────────────────────────────────────────────
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
# go.sum is generated by `go mod tidy` on first build; tidy also fetches deps.
RUN go mod tidy
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /out/davcloud ./cmd/server

# ── Runtime ─────────────────────────────────────────────────────────────────
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/davcloud /usr/local/bin/davcloud
COPY --from=ui /src/dist /app/ui
ENV DAVCLOUD_ADDR=:5232     DAVCLOUD_DATA=/data
VOLUME /data
EXPOSE 5232
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/davcloud"]
CMD ["-addr", ":5232", "-data-dir", "/data", "-ui-dir", "/app/ui"]
